   "source": [
    "## Perceptron Loss Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "def Perceptron(X,y):\n",
    "    w1=w2=b=1\n",
    "    lr = 0.1\n",
    "\n",
    "    for j in range(1000):\n",
    "\n",
    "        for i in range(X.shape[0]):\n",
    "            \n",
    "\n",
    "            # check condition\n",
    "            z = w1*X[i][0] + w2*X[i][1] + b\n",
    "    \n",
    "            if z*y[i]<0:\n",
    "                w1 = w1 * lr*y[i]*X[i][0]\n",
    "                w2 = w2 + lr*y[i]*X[i][1]\n",
    "                b = b + lr*y[i]\n",
    "\n",
    "    return w1,w2,b\n",
    "\n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "w1,w2,b = Perceptron(X,y)"
   ]
