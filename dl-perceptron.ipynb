.execute_reply.started":"2025-07-22T10:19:41.265145Z","shell.execute_reply":"2025-07-22T10:19:41.283437Z"}},"outputs":[],"execution_count":13},{"cell_type":"code","source":"def step(z):\n    return 1 if z>0 else 0","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-22T10:19:41.285427Z","iopub.execute_input":"2025-07-22T10:19:41.285781Z","iopub.status.idle":"2025-07-22T10:19:41.306569Z","shell.execute_reply.started":"2025-07-22T10:19:41.285757Z","shell.execute_reply":"2025-07-22T10:19:41.305504Z"}},"outputs":[],"execution_count":14},{"cell_type":"code","source":"intercept_,coef_ = perceptron(X,y)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-22T10:19:41.309612Z","iopub.execute_input":"2025-07-22T10:19:41.309924Z","iopub.status.idle":"2025-07-22T10:19:41.342234Z","shell.execute_reply.started":"2025-07-22T10:19:41.309902Z","shell.execute_reply":"2025-07-22T10:19:41.341193Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"print(coef_)\nprint(intercept_)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-22T10:19:41.343352Z","iopub.execute_input":"2025-07-22T10:19:41.343688Z","iopub.status.idle":"2025-07-22T10:19:41.351849Z","shell.execute_reply.started":"2025-07-22T10:19:41.343658Z","shell.execute_reply":"2025-07-22T10:19:41.350962Z"}},"outputs":[{"name":"stdout","text":"[1.2941133  0.09112103]\n1.0\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"m = -(coef_[0]/coef_[1])\nb = -(intercept_/coef_[1])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-22T10:19:41.352555Z","iopub.execute_input":"2025-07-22T10:19:41.352847Z","iopub.status.idle":"2025-07-22T10:19:41.375171Z","shell.execute_reply.started":"2025-07-22T10:19:41.352827Z","shell.execute_reply":"2025-07-22T10:19:41.374080Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"x_input = np.linspace(-3,3,100)\ny_input = m*x_input + b","metadata":{"trusted":true,"execution":{